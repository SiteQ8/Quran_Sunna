<?xml version="1.0" encoding="utf-8"?>
<!-- the ayah of the day on the app's own page, with its surah and number -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ayah_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_paper" android:layoutDirection="locale">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/ayah_head" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/widgetSample4" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widgetAccent" android:maxLines="1"/>
        <TextView android:id="@+id/ayah_ref" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:gravity="end"
            android:text="@string/widgetSample5" android:textSize="11sp" android:textColor="@color/widgetMuted" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/ayah_text"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:gravity="center"
        android:text="@string/widgetSample6"
        android:textSize="19sp" android:textColor="@color/widgetInk" android:lineSpacingMultiplier="1.35"
        android:maxLines="5" android:ellipsize="end" android:textDirection="rtl"/>
</LinearLayout>
