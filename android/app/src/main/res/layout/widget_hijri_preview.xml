<?xml version="1.0" encoding="utf-8"?>
<!-- the picker shows this widget at its own size, one cell high, so as
     widget_hijri_row lays it out: today's hijri date on its line, the weekday
     and the civil date under it. Four lines stacked in one cell left the
     date itself no room and cut the weekday at its top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hijri_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_paper" android:layoutDirection="locale">
    <ImageView android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="top|end"
        android:src="@drawable/widget_orn_band" android:tint="@color/widgetOrnament" android:tintMode="src_in"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/hijri_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/widgetSample20" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/widgetAccent"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="3dp">
            <TextView android:id="@+id/hijri_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/widgetSample19" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widgetMuted"
                android:maxLines="1" android:includeFontPadding="false"/>
            <TextView android:id="@+id/hijri_civil" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/widgetSample21" android:textSize="11sp" android:textColor="@color/widgetMuted"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
