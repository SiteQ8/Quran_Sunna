<?xml version="1.0" encoding="utf-8"?>
<!-- the day and its hijri date, the place, then the five prayers ahead -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_bg" android:layoutDirection="locale">
    <TextView android:id="@+id/day_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widgetAccent" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/day_place" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="@color/widgetMuted" android:maxLines="1" android:ellipsize="end"
        android:layout_marginBottom="6dp"/>

    <RelativeLayout android:id="@+id/day_row_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/day_time_0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" android:layout_centerVertical="true"
            android:textSize="14sp" android:textColor="@color/widgetInk" android:maxLines="1" android:fontFeatureSettings="tnum"/>
        <TextView android:id="@+id/day_name_0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentStart="true" android:layout_toStartOf="@id/day_time_0" android:layout_centerVertical="true"
            android:textSize="14sp" android:textColor="@color/widgetInk" android:maxLines="1" android:ellipsize="end"/>
    </RelativeLayout>
    <RelativeLayout android:id="@+id/day_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/day_time_1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" android:layout_centerVertical="true"
            android:textSize="14sp" android:textColor="@color/widgetInk" android:maxLines="1" android:fontFeatureSettings="tnum"/>
        <TextView android:id="@+id/day_name_1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentStart="true" android:layout_toStartOf="@id/day_time_1" android:layout_centerVertical="true"
            android:textSize="14sp" android:textColor="@color/widgetInk" android:maxLines="1" android:ellipsize="end"/>
    </RelativeLayout>
    <RelativeLayout android:id="@+id/day_row_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/day_time_2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" android:layout_centerVertical="true"
            android:textSize="14sp" android:textColor="@color/widgetInk" android:maxLines="1" android:fontFeatureSettings="tnum"/>
        <TextView android:id="@+id/day_name_2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentStart="true" android:layout_toStartOf="@id/day_time_2" android:layout_centerVertical="true"
            android:textSize="14sp" android:textColor="@color/widgetInk" android:maxLines="1" android:ellipsize="end"/>
    </RelativeLayout>
    <RelativeLayout android:id="@+id/day_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/day_time_3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" android:layout_centerVertical="true"
            android:textSize="14sp" android:textColor="@color/widgetInk" android:maxLines="1" android:fontFeatureSettings="tnum"/>
        <TextView android:id="@+id/day_name_3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentStart="true" android:layout_toStartOf="@id/day_time_3" android:layout_centerVertical="true"
            android:textSize="14sp" android:textColor="@color/widgetInk" android:maxLines="1" android:ellipsize="end"/>
    </RelativeLayout>
    <RelativeLayout android:id="@+id/day_row_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/day_time_4" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" android:layout_centerVertical="true"
            android:textSize="14sp" android:textColor="@color/widgetInk" android:maxLines="1" android:fontFeatureSettings="tnum"/>
        <TextView android:id="@+id/day_name_4" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentStart="true" android:layout_toStartOf="@id/day_time_4" android:layout_centerVertical="true"
            android:textSize="14sp" android:textColor="@color/widgetInk" android:maxLines="1" android:ellipsize="end"/>
    </RelativeLayout>
</LinearLayout>
