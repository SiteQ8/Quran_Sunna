<?xml version="1.0" encoding="utf-8"?>
<!-- the day's five prayers over the sky of the hour, the next one lifted,
     the ones gone faded and marked when the reader marked them prayed; the
     day and its hijri date above, the place beside them. Its words are
     pictures in the app's own face, drawn by WidgetText; the picker shows
     widget_day_preview. -->
<!-- each picture of words is given its words to be read aloud with it, by
     WidgetText.put, so none is described here -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="ContentDescription"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:layoutDirection="locale">
    <ImageView android:id="@+id/day_sky"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/widget_sky_morning" android:importantForAccessibility="no"/>
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_scrim" android:importantForAccessibility="no"/>
    <ImageView android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="top|end"
        android:src="@drawable/widget_orn_line" android:tint="@color/widgetOrnamentSky" android:tintMode="src_in"
        android:importantForAccessibility="no"/>
    <FrameLayout android:id="@+id/day_root"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="top" android:orientation="vertical">
            <ImageView android:id="@+id/day_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:adjustViewBounds="true" android:scaleType="fitCenter"/>
            <ImageView android:id="@+id/day_place" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:adjustViewBounds="true" android:scaleType="fitCenter"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:id="@+id/day_col_0"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="2dp" android:paddingEnd="2dp"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/day_name_0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:adjustViewBounds="true" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/day_time_0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:adjustViewBounds="true" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/day_mark_0" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginTop="2dp"
                    android:src="@drawable/widget_check" android:importantForAccessibility="no" android:visibility="invisible"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/day_col_1"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="2dp" android:paddingEnd="2dp"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/day_name_1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:adjustViewBounds="true" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/day_time_1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:adjustViewBounds="true" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/day_mark_1" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginTop="2dp"
                    android:src="@drawable/widget_check" android:importantForAccessibility="no" android:visibility="invisible"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/day_col_2"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="2dp" android:paddingEnd="2dp"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/day_name_2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:adjustViewBounds="true" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/day_time_2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:adjustViewBounds="true" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/day_mark_2" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginTop="2dp"
                    android:src="@drawable/widget_check" android:importantForAccessibility="no" android:visibility="invisible"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/day_col_3"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="2dp" android:paddingEnd="2dp"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/day_name_3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:adjustViewBounds="true" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/day_time_3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:adjustViewBounds="true" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/day_mark_3" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginTop="2dp"
                    android:src="@drawable/widget_check" android:importantForAccessibility="no" android:visibility="invisible"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/day_col_4"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="2dp" android:paddingEnd="2dp"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/day_name_4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:adjustViewBounds="true" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/day_time_4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:adjustViewBounds="true" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/day_mark_4" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginTop="2dp"
                    android:src="@drawable/widget_check" android:importantForAccessibility="no" android:visibility="invisible"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
