<?xml version="1.0" encoding="utf-8"?>
<!-- the prayers of today, fajr to isha, each a disc filled with a tick once the reader marked it prayed in the app, the next one ringed in red, and how many are prayed; a tap opens the log; the picker shows widget_log_preview -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="ContentDescription"
    android:id="@+id/log_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_paper" android:layoutDirection="locale">
    <ImageView android:layout_width="140dp" android:layout_height="140dp" android:layout_gravity="top|end"
        android:src="@drawable/widget_orn_band" android:tint="@color/widgetOrnament" android:tintMode="src_in"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <ImageView android:id="@+id/log_head" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:adjustViewBounds="true" android:scaleType="fitCenter"
                android:tint="@color/widgetAccent" android:tintMode="src_in"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="8dp" android:orientation="horizontal" android:gravity="end|center_vertical">
                <ImageView android:id="@+id/log_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:adjustViewBounds="true" android:scaleType="fitCenter"
                    android:tint="@color/widgetMuted" android:tintMode="src_in"/>
            </LinearLayout>
        </LinearLayout>
    <!-- the five stand in the middle of the room under the heading -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" tools:ignore="UselessParent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical"
        android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:id="@+id/log_col1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/log_dot1" android:layout_width="30dp" android:layout_height="30dp"
                android:src="@drawable/widget_dot_open" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/log_name1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:adjustViewBounds="true" android:scaleType="fitCenter"
                android:tint="@color/widgetInk" android:tintMode="src_in"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/log_col2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/log_dot2" android:layout_width="30dp" android:layout_height="30dp"
                android:src="@drawable/widget_dot_open" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/log_name2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:adjustViewBounds="true" android:scaleType="fitCenter"
                android:tint="@color/widgetInk" android:tintMode="src_in"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/log_col3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/log_dot3" android:layout_width="30dp" android:layout_height="30dp"
                android:src="@drawable/widget_dot_open" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/log_name3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:adjustViewBounds="true" android:scaleType="fitCenter"
                android:tint="@color/widgetInk" android:tintMode="src_in"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/log_col4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/log_dot4" android:layout_width="30dp" android:layout_height="30dp"
                android:src="@drawable/widget_dot_open" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/log_name4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:adjustViewBounds="true" android:scaleType="fitCenter"
                android:tint="@color/widgetInk" android:tintMode="src_in"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/log_col5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/log_dot5" android:layout_width="30dp" android:layout_height="30dp"
                android:src="@drawable/widget_dot_open" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/log_name5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:adjustViewBounds="true" android:scaleType="fitCenter"
                android:tint="@color/widgetInk" android:tintMode="src_in"/>
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
    </LinearLayout>
</FrameLayout>
