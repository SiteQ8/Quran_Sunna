<?xml version="1.0" encoding="utf-8"?>
<!-- the next prayer over the painted sky of the hour: a heading, the prayer,
     a line under it in ramadan, its time, the time left, the bar of the time
     gone since the prayer before, the place. The words are pictures drawn in
     the app's own face by WidgetText, since a launcher loads no font of
     another app; only the time left, which counts by itself, is the
     launcher's. The picker shows widget_prayer_preview. -->
<!-- each picture of words is given its words to be read aloud with it, by
     WidgetText.put, so none is described here -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="ContentDescription"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:layoutDirection="locale">

    <ImageView android:id="@+id/widget_sky"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/widget_sky_afternoon"
        android:importantForAccessibility="no"/>
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_scrim" android:importantForAccessibility="no"/>
    <ImageView android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="top|end"
        android:src="@drawable/widget_orn_line" android:tint="@color/widgetOrnamentSky" android:tintMode="src_in"
        android:importantForAccessibility="no"/>

    <LinearLayout android:id="@+id/widget_root"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="12dp">

        <ImageView android:id="@+id/widget_head"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitCenter"/>
        <ImageView android:id="@+id/widget_name"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitCenter"/>
        <ImageView android:id="@+id/widget_sub"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitCenter" android:visibility="gone"/>
        <ImageView android:id="@+id/widget_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitCenter"/>

        <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

        <Chronometer android:id="@+id/widget_left"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="26sp" android:textColor="#FFFFFFFF" android:fontFeatureSettings="tnum"
            android:fontFamily="sans-serif-medium" android:maxLines="1"
            android:shadowColor="#80000000" android:shadowRadius="4" android:shadowDy="1"/>

        <ProgressBar android:id="@+id/widget_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp"
            android:max="1000" android:progress="620" android:progressDrawable="@drawable/widget_progress_sky"/>

        <ImageView android:id="@+id/widget_place"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:adjustViewBounds="true" android:scaleType="fitCenter"/>
    </LinearLayout>
</FrameLayout>
