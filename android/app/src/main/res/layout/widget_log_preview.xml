<?xml version="1.0" encoding="utf-8"?>
<!-- the prayer log as widget_log lays it out -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="ContentDescription"
    android:id="@+id/log_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_paper" android:layoutDirection="locale">
    <ImageView android:layout_width="140dp" android:layout_height="140dp" android:layout_gravity="top|end"
        android:src="@drawable/widget_orn_band" android:tint="@color/widgetOrnament" android:tintMode="src_in"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/widgetLogName" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widgetAccent" android:maxLines="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/widgetSample31" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widgetMuted" android:maxLines="1"/>
        </LinearLayout>
    <!-- the five stand in the middle of the room under the heading -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" tools:ignore="UselessParent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical"
        android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal" android:drawableTop="@drawable/widget_dot_done" android:drawablePadding="5dp"
            android:text="@string/widgetSample8" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widgetInk" android:maxLines="1"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal" android:drawableTop="@drawable/widget_dot_done" android:drawablePadding="5dp"
            android:text="@string/widgetSample11" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widgetInk" android:maxLines="1"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal" android:drawableTop="@drawable/widget_dot_done" android:drawablePadding="5dp"
            android:text="@string/widgetSample13" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widgetInk" android:maxLines="1"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal" android:drawableTop="@drawable/widget_dot_next" android:drawablePadding="5dp"
            android:text="@string/widgetSample15" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widgetInk" android:maxLines="1"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal" android:drawableTop="@drawable/widget_dot_open" android:drawablePadding="5dp"
            android:text="@string/widgetSample17" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widgetInk" android:maxLines="1"/>
    </LinearLayout>
    </FrameLayout>
    </LinearLayout>
</FrameLayout>
