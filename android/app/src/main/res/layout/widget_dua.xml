<?xml version="1.0" encoding="utf-8"?>
<!-- the du'a of the day from the Quran and the Sunnah, laid out as the ayah
     of the day: its heading and kind at the top, the du'a filling the middle,
     a short gold rule, its source, and the refresh that turns to another;
     the picker shows widget_dua_preview -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="ContentDescription"
    android:id="@+id/dua_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_paper" android:layoutDirection="locale">
    <ImageView android:layout_width="130dp" android:layout_height="130dp" android:layout_gravity="top|end"
        android:src="@drawable/widget_orn_band" android:tint="@color/widgetOrnament" android:tintMode="src_in"
        android:importantForAccessibility="no"/>
    <ImageView android:layout_width="130dp" android:layout_height="130dp" android:layout_gravity="bottom|start"
        android:rotation="180"
        android:src="@drawable/widget_orn_band" android:tint="@color/widgetOrnament" android:tintMode="src_in"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <ImageView android:id="@+id/dua_head" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:adjustViewBounds="true" android:scaleType="fitCenter"
                android:tint="@color/widgetAccent" android:tintMode="src_in"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="8dp" android:orientation="horizontal" android:gravity="end|center_vertical">
                <ImageView android:id="@+id/dua_topic" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:adjustViewBounds="true" android:scaleType="fitCenter"
                    android:tint="@color/widgetMuted" android:tintMode="src_in"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/dua_text"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="6dp" android:layout_marginBottom="4dp" android:scaleType="centerInside"
            android:tint="@color/widgetInk" android:tintMode="src_in"/>
        <ImageView android:layout_width="36dp" android:layout_height="1.5dp"
            android:background="@color/widgetOrnamentRule" android:importantForAccessibility="no"/>
        <!-- its source in the middle: the surah and ayah, or the book of
             hadith; at the end the refresh -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="4dp">
            <ImageView android:id="@+id/dua_ref" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:layout_marginStart="38dp" android:layout_marginEnd="38dp"
                android:adjustViewBounds="true" android:scaleType="fitCenter"
                android:tint="@color/widgetMuted" android:tintMode="src_in"/>
            <ImageView android:id="@+id/dua_next" android:layout_width="30dp" android:layout_height="30dp"
                android:layout_gravity="end|center_vertical" android:padding="6dp"
                android:background="@drawable/widget_round" android:src="@drawable/widget_refresh"
                android:tint="@color/widgetAccent" android:tintMode="src_in"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
